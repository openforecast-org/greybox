# Compiled extensions. CI builds these for every wheel, and `pip install -e .`
# builds them for a local checkout, so a committed copy is never read -- it only
# shadows the fresh build for whichever ABI happens to match.
*.so
*.pyd
*.dylib
*.o

# Claude Code: keep local settings out, but track shared skills
.claude/*
!.claude/skills/
